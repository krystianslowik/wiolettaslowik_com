---
import type { Copy, Locale } from "../i18n";
import { homeUrl, packagesUrl } from "../i18n";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const isEn = t.locale === "en";

const rawPath = Astro.url.pathname || "/";
const path = rawPath.endsWith("/") ? rawPath : `${rawPath}/`;

// Map current path to its counterpart in the other locale. Default is the
// other locale's home page, so an unknown path still has a sensible target.
function urlFor(locale: Locale): string {
  const enPkg = packagesUrl("en");
  const dePkg = packagesUrl("de");
  if (path === enPkg || path === dePkg) return packagesUrl(locale);
  return homeUrl(locale);
}

const enHref = urlFor("en");
const deHref = urlFor("de");
---

<div class="lang-switch" role="group" aria-label={t.langSwitch.label}>
  <a
    href={enHref}
    class={isEn ? "is-active" : ""}
    aria-current={isEn ? "true" : undefined}
    data-set-lang="en">{t.langSwitch.en}</a>
  <span class="lang-divider" aria-hidden="true">·</span>
  <a
    href={deHref}
    class={!isEn ? "is-active" : ""}
    aria-current={!isEn ? "true" : undefined}
    data-set-lang="de">{t.langSwitch.de}</a>
</div>

<script>
  // Persist the user's explicit language pick so the auto-redirect on `/` honors it.
  document.querySelectorAll<HTMLAnchorElement>("a[data-set-lang]").forEach((a) => {
    a.addEventListener("click", () => {
      try {
        localStorage.setItem("ws_lang", a.dataset.setLang ?? "");
      } catch {}
    });
  });
</script>
