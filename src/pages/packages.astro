---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import PackagesSection from "../components/Packages.astro";
import Process from "../components/Process.astro";
import Footer from "../components/Footer.astro";
import { getCopy, homeUrl } from "../i18n";

const t = getCopy("en");
---

<Base t={t} kind="packages">
  <Nav t={t} />
  <main>
    <p class="page-prelink">
      <a href={homeUrl("en")}>{t.packages.backToHome}</a>
    </p>
    <PackagesSection t={t} />
    <Process t={t} index="02" />
  </main>
  <Footer t={t} />
</Base>
