---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Focus from "../components/Focus.astro";
import Process from "../components/Process.astro";
import Systems from "../components/Systems.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { getCopy } from "../i18n";

const t = getCopy("en");
---

<Base t={t}>
  <Nav t={t} />
  <main>
    <Hero t={t} />
    <About t={t} />
    <Focus t={t} />
    <Process t={t} />
    <Systems t={t} />
    <Experience t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />

  <script is:inline>
    // First-visit auto-redirect to /de/ for German browsers. Skipped if the
    // user has ever picked a language explicitly (LangSwitch persists this).
    try {
      var saved = localStorage.getItem("ws_lang");
      var nav = (navigator.language || "").toLowerCase();
      if (!saved && nav.indexOf("de") === 0) {
        localStorage.setItem("ws_lang", "de");
        location.replace("/de/");
      } else if (!saved) {
        localStorage.setItem("ws_lang", "en");
      }
    } catch (e) {}
  </script>
</Base>
